---
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/inter-tight";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { site, socials } from "../data/profile";

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL("/og.jpg", Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.url}/#person`,
      name: site.name,
      jobTitle: site.role,
      description: site.description,
      url: site.url,
      address: { "@type": "PostalAddress", addressLocality: "Chandigarh", addressCountry: "IN" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Punjab Technical University" },
      worksFor: { "@type": "Organization", name: "PKWARE", url: "https://www.pkware.com/" },
      knowsAbout: [
        "Artificial intelligence", "LLM agents", "AI automation", "OpenAI API", "Anthropic Claude API", "ElevenLabs", "ChatGPT", "Claude Code", "Codex",
        "Python", "Java", "Kotlin", "Spring Boot", "Hibernate", "TypeScript", "JavaScript", "Angular", "React", "Next.js", "Node.js",
        "MongoDB", "MySQL", "AWS", "Google Cloud", "Azure", "Docker", "Kubernetes", "UI/UX design",
      ],
      sameAs: socials.map((s) => s.href),
    },
    { "@type": "WebSite", "@id": `${site.url}/#website`, url: site.url, name: site.name, inLanguage: "en", publisher: { "@id": `${site.url}/#person` } },
    { "@type": "ProfilePage", "@id": `${canonical}#page`, url: canonical, name: title, mainEntity: { "@id": `${site.url}/#person` } },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0a0908" />
    <meta name="keywords" content="Vishal Rana, AI engineer, full-stack developer, LLM agents, AI automation, OpenAI, Claude, ElevenLabs, Python, Java, Kotlin, Spring Boot, Hibernate, TypeScript, Angular, React, Node.js, Chandigarh" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vishal Rana — AI & Full-Stack Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@vishalranaa" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Motion layer only hides content when JS runs and the visitor allows motion; crawlers see everything.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
