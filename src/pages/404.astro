---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Vishal Rana" description="This page doesn't exist." noindex>
  <main id="main" class="notfound">
    <div class="notfound__glow" aria-hidden="true"></div>
    <p class="label" style="justify-content:center"><span>404</span>Lost in space</p>
    <h1 class="notfound__title">Nothing <em class="gold">here.</em></h1>
    <p class="head__lead" style="margin-inline:auto">The page you're looking for has moved, or never existed.</p>
    <a class="btn btn--gold" href="/"><span>Return home</span></a>
  </main>
</Base>
